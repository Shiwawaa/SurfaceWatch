# SurfaceWatch Environment Configuration
# Copy this file to .env and adjust values for your environment.

APP_NAME=SurfaceWatch
APP_ENV=production
DATABASE_URL=sqlite:///./data/surfacewatch.db

# Identity & Safety Controls
USER_AGENT=SurfaceWatch/1.0 (+https://github.com/surfacewatch/surfacewatch; defensive-authorized-scan)
REQUEST_TIMEOUT_SECONDS=8.0
PORT_TIMEOUT_SECONDS=2.0
RATE_LIMIT_REQUESTS_PER_SECOND=2.0
MAX_SUBDOMAINS=50
DEFAULT_SCAN_INTERVAL_DAYS=7
OPERATOR_ID=local-owner
ALLOW_SELF_ATTESTATION=true

# Optional Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional SMTP Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
